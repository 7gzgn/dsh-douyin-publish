{
  "name": "dsh-douyin-publish",
  "version": "0.6.4",
  "description": "把一段本地视频一路送到抖音 / B站投稿页的待发布状态，默认停手不发布。 Take a local video to a creator post page and stop before publishing unless explicitly told to.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-douyin-publish": "bin/dsh-douyin-publish.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./pipeline": "./lib/pipeline.js",
    "./plan": "./lib/plan.js",
    "./platforms": "./lib/platforms.js",
    "./serve": "./lib/serve.js",
    "./attach": "./lib/attach.js",
    "./handover": "./lib/handover.js",
    "./handover.ps1": "./lib/handover.ps1",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "douyin",
    "bilibili",
    "tiktok",
    "video-upload",
    "publish",
    "creator",
    "browser-automation",
    "file-input",
    "抖音",
    "B站",
    "发布"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7gzgn/dsh-douyin-publish.git"
  },
  "homepage": "https://github.com/7gzgn/dsh-douyin-publish#readme",
  "bugs": {
    "url": "https://github.com/7gzgn/dsh-douyin-publish/issues"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
